--- /dev/null
+++ b/tests/integration/test_inspect.metta
@@ -0,0 +1,26 @@
+; Plan-inspection commands (trace / validate / assign). These assertions pin the
+; structured results (sorted assignment sets, validity verdicts) so regressions
+; in extraction or rendering surface as concrete value mismatches.
+
+!(import! &self (library OmegaClaw-Core lib_directive))
+
+; assign: active (non-completed) assignment literals, sorted, all agents.
+!(test (let* (($_ (dl-run (dl-path tests/deontic/fixtures/basic-tasks.metta)))
+              ($names (directive-pos-names)))
+         (assign-names $names ""))
+       (assign-to-auth-coder assign-to-auth-reviewer assign-to-models-coder))
+
+; assign filtered by a specific agent (reviewer only gets the auth-reviewer slot).
+!(test (let* (($_ (dl-run (dl-path tests/deontic/fixtures/basic-tasks.metta)))
+              ($names (directive-pos-names)))
+         (assign-names $names reviewer))
+       (assign-to-auth-reviewer))
+
+; validate: a well-formed plan is valid (the dangling tests-failing literal only
+; yields warnings, not errors, in non-strict mode).
+!(test (directive-validate (dl-path tests/deontic/fixtures/basic-tasks.metta) False) True)
+
+; penguin.metta is clean -> valid with no warnings.
+!(test (directive-validate (dl-path tests/deontic/fixtures/penguin.metta) False) True)
+
+!(println! test-inspect-done)
diff --git a/tests/integration/test_mining.metta b/tests/integration/test_mining.metta
new file mode 100644
index 0000000000000000000000000000000000000000..bc9b481be227e6c363af860e0fe2d83a9a23174a
--- /dev/null
+++ b/tests/integration/test_mining.metta
@@ -0,0 +1,36 @@
+; Process-mining tests (rule learning from event logs). These assertions pin the
+; deterministic structured results — learned causal rules with their support and
+; confidence, the per-case event log, and that the renderers run end to end — so
+; regressions surface fast.
+
+!(import! &self (library OmegaClaw-Core lib_directive))
+
+; --- rule learning: linear trace step1 -> step2 -> step3 ---
+; two causal pairs, full support/confidence, sorted by (body,head).
+!(test (mining-rules ((dl-path tests/deontic/fixtures/mining_seq.metta)) 1 0.5)
+       ((step1 step2 1 "1.00") (step2 step3 1 "1.00")))
+
+; --- multi-trace XOR branch: start -> {pick_b | pick_c} -> join ---
+; fractional confidence (start has two outgoing edges across the 2 traces).
+!(test (mining-rules ((dl-path tests/deontic/fixtures/mining_branchA.metta)
+                      (dl-path tests/deontic/fixtures/mining_branchB.metta)) 1 0.5)
+       ((pick_b join 1 "1.00") (pick_c join 1 "1.00")
+        (start pick_b 1 "0.50") (start pick_c 1 "0.50")))
+
+; min-confidence filter drops the 0.50 edges, keeping the certain ones.
+!(test (mining-rules ((dl-path tests/deontic/fixtures/mining_branchA.metta)
+                      (dl-path tests/deontic/fixtures/mining_branchB.metta)) 1 0.7)
+       ((pick_b join 1 "1.00") (pick_c join 1 "1.00")))
+
+; --- event log: one case per file, events in timestamp order ---
+!(test (size-atom (mining-event-log ((dl-path tests/deontic/fixtures/mining_seq.metta)))) 1)
+!(test (let ($id $evs) (car-atom (mining-event-log ((dl-path tests/deontic/fixtures/mining_seq.metta)))) $id)
+       mining_seq)
+
+; --- renderers run and return true (exact output shape exercised here) ---
+!(test (mining-extract-print ((dl-path tests/deontic/fixtures/mining_seq.metta)) json) true)
+!(test (mining-rules-print ((dl-path tests/deontic/fixtures/mining_seq.metta)) dfl 1 0.5) true)
+!(test (mining-rules-print ((dl-path tests/deontic/fixtures/mining_branchA.metta)
+                            (dl-path tests/deontic/fixtures/mining_branchB.metta)) summary 1 0.0) true)
+
+!(println! test-mining-done)
diff --git a/tests/integration/test_nal.metta b/tests/integration/test_nal.metta
new file mode 100644
index 0000000000000000000000000000000000000000..cdc43cbab044a7a444295ea9db9615db67715ab4
--- /dev/null
+++ b/tests/integration/test_nal.metta
@@ -0,0 +1,51 @@
+; lib_deontic <-> NAL belief-bridge tests (opt-in Feature A).
+; Unlike the earlier design-stage seam, NAL is actually present, so these assert
+; real cross-engine behavior: the trust<->(stv) numeric bridge, the literal<->NAL
+; term mapping both ways, projecting defeasible conclusions out to beliefs,
+; injecting credible beliefs back in, and a full belief->reason->belief round trip.
+!(import! &self (library OmegaClaw-Core src/integration/nal))
+
+; float-tolerant equality (NAL truth math is floating point)
+(= (approx $a $b) (< (let $d (- $a $b) (if (< $d 0.0) (- 0.0 $d) $d)) 0.0001))
+
+; --- trust <-> truth value (projected expectation E = c*(f-0.5)+0.5) ---
+!(test (approx (stv->trust (stv 1.0 0.9)) 0.95) True)
+!(test (approx (stv->trust (stv 0.0 0.9)) 0.05) True)
+!(test (trust->stv 0.7) (stv 0.7 (Truth_w2c 2.0)))
+
+; --- literal <-> NAL term ---
+!(test (lit->term (lit pos none none bird ())) bird)
+!(test (lit->term (lit pos none none flies (tweety))) (--> tweety flies))
+!(test (lit->term (lit pos none none parent (alice bob))) (--> (× alice bob) parent))
+!(test (term->plit bird) (lit pos none none bird ()))
+!(test (term->plit (--> tweety flies)) (lit pos none none flies (tweety)))
+!(test (term->plit (--> (× alice bob) parent)) (lit pos none none parent (alice bob)))
+
+; --- conclusion -> belief (factual + defeasible only; sign sets frequency) ---
+!(test (concl->belief (pd (lit pos none none bird ()))) (bird (stv 1.0 0.81)))
+!(test (concl->belief (pd (lit neg none none flies ()))) (flies (stv 0.0 0.81)))
+!(test (concl->belief (nd (lit pos none none flies ()))) ())
+!(test (concl->belief (pd (lit pos O none pay ()))) ())
+
+; --- belief -> deontic fact (signed by belief direction; expectation-gated) ---
+!(test (belief->fact (bird (stv 1.0 0.9)) 0.5) (dfact (lit pos none none bird ()) 0.95))
+!(test (belief->fact (flies (stv 0.0 0.9)) 0.5) (dfact (lit neg none none flies ()) 0.95))
+!(test (belief->fact (bird (stv 0.5 0.9)) 0.5) ())
+
+; --- project a real defeasible run OUT to beliefs (penguin: flies is false) ---
+!(test (is-member (bird (stv 1.0 0.81))
+                  (theory->beliefs (dl-path examples/deontic/penguin.metta))) True)
+!(test (is-member (flies (stv 0.0 0.81))
+                  (theory->beliefs (dl-path examples/deontic/penguin.metta))) True)
+
+; --- full round trip: NAL belief -> injected fact -> defeasible reasoning ->
+;     new belief. bird is supplied only by the injected belief; r1 then derives flies. ---
+!(test (is-member (flies (stv 1.0 0.81))
+                  (combined-step (dl-path tests/integration/bridge_demo.metta)
+                                 ((bird (stv 1.0 0.9))) 0.5)) True)
+
+; --- NAL revision fuses two evidence sources about the same term ---
+!(test (is-member (bird (Truth_Revision (stv 1.0 0.5) (stv 1.0 0.5)))
+                  (infer (bird (stv 1.0 0.5)) (bird (stv 1.0 0.5)))) True)
+
+!(println! test-nal-done)
diff --git a/tests/integration/test_policy_guard.metta b/tests/integration/test_policy_guard.metta
