+    with open(crash_log) as f:
+        lines = [json.loads(l) for l in f if l.strip()]
+    assert len(lines) == 3
+    assert lines[0]["classification"] == "SIGSEGV"
+    assert lines[1]["classification"] == "OOM_KILL"
+    assert lines[2]["classification"] == "normal_exit"
