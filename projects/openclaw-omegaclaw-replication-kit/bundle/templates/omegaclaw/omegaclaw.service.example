[Unit]
Description=OmegaClaw Telegram Bot API worker
After=network-online.target openclaw-gateway.service
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/research-agent/projects/omegaclaw
EnvironmentFile=%h/.openclaw/omegaclaw-telegram.env
# Put OPENCLAW_GATEWAY_TOKEN in a separate protected EnvironmentFile or a
# systemd credential/SecretRef bridge; do not hard-code it in this unit.
EnvironmentFile=%h/.openclaw/omegaclaw-gateway.env
ExecStart=%h/research-agent/projects/omegaclaw/local/run-omegaclaw-telegram.sh
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/research-agent/projects/omegaclaw

[Install]
WantedBy=default.target
