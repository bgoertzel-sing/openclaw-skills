# Copy to ~/.openclaw/omegaclaw-telegram.env, chmod 600, and fill locally.
# Never commit the filled file.
export OMEGACLAW_TG_BOT_TOKEN='<OMEGACLAW_TELEGRAM_BOT_TOKEN>'

# Bot API 10 receive path; MTProto is intentionally disabled.
export TG_RECEIVE_TRANSPORT='bot_api'
export TG_USE_MTPROTO='false'
export TG_SYNC_POLL='false'
export TG_PRIVATE_ONLY='false'
export TG_CHAT_IDS='<OWNER_DM_ID>,<MAIN_GROUP_ID>,<BOT_DISCUSSION_GROUP_ID>,<SCHEDULED_UPDATES_GROUP_ID>'
export TG_CHAT_ID='<OWNER_DM_ID>'
export TG_ALLOWED_USER_IDS='<OWNER_TELEGRAM_USER_ID>'
export TG_SKIP_INITIAL_OFFSET='false'
export TG_POLL_TIMEOUT='20'

# Local OpenClaw Gateway endpoint. Supply the token through a protected env/service
# file or let the runner read the configured local SecretRef; never put it here if
# this template might be shared.
export OPENCLAW_GATEWAY_BASE_URL='http://127.0.0.1:18789/v1'
export OPENCLAW_MODEL='openclaw/default'
export OPENCLAW_SESSION_PER_CALL='true'
export OPENCLAW_HTTP_TIMEOUT='900'
export OPENCLAW_SUBPROCESS_TIMEOUT='900'

# Conservative loop/idle behavior.
export OMEGACLAW_MAX_NEW_INPUT_LOOPS='50'
export OMEGACLAW_MAX_WAKE_LOOPS='0'
export OMEGACLAW_WAKEUP_INTERVAL='3600'
export OMEGACLAW_MAX_OUTPUT_TOKENS='2048'
