// Advanced memory proposal. Merge only after checking the installed schema,
// plugin availability, disk space, and latency. QMD's first semantic query can
// download about 2 GB of local models.
{
  memory: {
    backend: "qmd",
    citations: "auto",
    qmd: {
      searchMode: "query",
      includeDefaultMemory: true,
      paths: [
        {
          name: "projects",
          path: "~/research-agent/projects",
          pattern: "**/*.md",
        },
        {
          name: "library",
          path: "~/research-agent/library",
          pattern: "**/*.md",
        },
        {
          name: "catalog",
          path: "~/research-agent/catalog",
          pattern: "**/*.md",
        },
      ],
      sessions: {
        enabled: true,
        retentionDays: 180,
      },
      update: {
        interval: "5m",
        debounceMs: 15000,
        onBoot: true,
        startup: "idle",
      },
      limits: {
        maxResults: 10,
        maxSnippetChars: 1800,
        maxInjectedChars: 12000,
        timeoutMs: 10000,
      },
      scope: {
        default: "deny",
        rules: [
          {
            action: "allow",
            match: {
              chatType: "direct",
            },
          },
        ],
      },
    },
  },

  plugins: {
    entries: {
      "active-memory": {
        enabled: true,
        config: {
          enabled: true,
          agents: ["main"],
          allowedChatTypes: ["direct"],
          queryMode: "recent",
          promptStyle: "recall-heavy",
          timeoutMs: 15000,
          setupGraceTimeoutMs: 30000,
          maxSummaryChars: 400,
          persistTranscripts: false,
          logging: true,
          promptAppend: "Prefer durable project facts, prior decisions, experiment results, unresolved questions, and stable user preferences. Return NONE rather than weak or speculative matches.",
        },
      },

      "memory-core": {
        config: {
          dreaming: {
            enabled: true,
            timezone: "America/Los_Angeles",
            frequency: "0 3 * * *",
          },
        },
      },

      // Optional: enable only when the plugin is installed and
      // `openclaw wiki doctor` confirms bridge support.
      "memory-wiki": {
        enabled: true,
        config: {
          vaultMode: "bridge",
          bridge: {
            enabled: true,
            readMemoryArtifacts: true,
            indexDreamReports: true,
            indexDailyNotes: true,
            indexMemoryRoot: true,
            followMemoryEvents: true,
          },
          search: {
            backend: "shared",
            corpus: "all",
          },
          context: {
            includeCompiledDigestPrompt: false,
          },
        },
      },
    },
  },
}
