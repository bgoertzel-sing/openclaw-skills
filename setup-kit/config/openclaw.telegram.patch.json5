// Replace the placeholder with Benjamin's numeric Telegram user ID.
// Configure the bot token interactively or with a supported SecretRef.
// Never commit the token or put it in memory.
{
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["<BENJAMIN_TELEGRAM_NUMERIC_USER_ID>"],
      groupPolicy: "disabled",
    },
  },
  commands: {
    ownerAllowFrom: [
      "telegram:<BENJAMIN_TELEGRAM_NUMERIC_USER_ID>",
    ],
  },
}
